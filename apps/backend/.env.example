# Copy the values you need into apps/backend/.env (never commit .env).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/maintain?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters
OLLAMA_URL=http://127.0.0.1:11434
AI_ENABLED=false
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=maintain
CORS_ORIGINS=http://localhost:3001
WEB_URL=http://localhost:3001
API_PORT=3000
# Optional
LOGIN_RATE_LIMIT=5
GLOBAL_RATE_LIMIT=120
# Seed script only
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=

# Optional: raise the 5 s database transaction timeout (useful with a remote database such as Neon)
# DB_TRANSACTION_TIMEOUT_MS=30000
